# Godot 4+ specific ignores
.godot/
/android/
/.editorconfig
/.gitattributes
/Thumbs.db
/templates/resources/battle_maps/Thumbs.db
/__pycache__
Thumbs.db
/.env
__pycache__
/item.json

# Node : dépendances de test uniquement (jsdom). package.json / package-lock.json, eux,
# restent SUIVIS — ce sont eux qui permettent de reconstituer node_modules (npm install).
node_modules/

# Synology : métadonnées déposées dans chaque dossier du partage (vignettes, flux étendus),
# invisibles depuis Windows mais vues par le git du conteneur.
@eaDir/
*@SynoEAStream
#recycle/
.pytest_cache/

# Claude Code : réglages personnels (permissions locales), jamais partagés.
.claude/settings.local.json
