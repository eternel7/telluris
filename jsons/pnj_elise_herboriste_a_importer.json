        "apport_accepte": {
          "texte": "Elle tire d'un pot une corolle séchée, d'un orange encore vif, et la pose dans ta paume. « Voilà à quoi elle ressemble. Il m'en faut trois. Elle pousse sur les collines, au nord-est de la ville. Et si tu n'es pas sûr… »",
          "choix": [
            {
              "id": "fin",
              "label": "« … je ne la cueille pas. »",
              "next": "fin"
            }
          ]
        },
        "apport_rappel": {
          "texte": "« Une fleur orange, comme un petit soleil. Sur les collines, au nord-est de la ville. Il m'en faut encore {reste}. Et pas une que tu ne sois sûr de reconnaître. »",
          "choix": [
            {
              "id": "fin",
              "label": "« Je n'ai pas oublié. »",
              "next": "fin"
            }
          ]
        },
        "apport_partiel": {
          "texte": "Elle fait tourner la fleur entre ses doigts, la sent. « C'est bien elle. » Elle la pose à sécher près de l'âtre. « Encore {reste}. »",
          "choix": [
            {
              "id": "fin",
              "label": "« J'y retourne. »",
              "next": "fin"
            }
          ]
        },
        "apport_remis": {
          "texte": "Elle examine les fleurs une à une, les fait tourner entre ses doigts, les sent. « C'est bien elle. » Elle les suspend au-dessus de l'âtre, à côté des autres bouquets. « Trois plantes. Te voilà quitte. »",
          "choix": [
            {
              "id": "fin",
              "label": "(Sourire.)",
              "next": "fin"
            }
          ]
        },
        "s1_01": {
          "texte": "Elle lève les yeux, voit ta main, et pousse un tabouret du pied. « Assieds-toi. Et ne bouge pas. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je vais bien. »",
              "next": "s1_02"
            }
          ]
        },
        "s1_02": {
          "texte": "« Bien sûr. C'est pour ça que tu saignes sur mon plancher. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Ce n'est qu'une égratignure. »",
              "next": "s1_03"
            }
          ]
        },
        "s1_03": {
          "texte": "« Alors tu ne verras aucun inconvénient à ce que je la nettoie. » Elle débouche déjà un flacon.",
          "choix": [
            {
              "id": "suite",
              "label": "« Vous êtes toujours aussi aimable avec les voyageurs ? »",
              "next": "s1_04"
            }
          ]
        },
        "s1_04": {
          "texte": "« Seulement ceux qui essaient de me convaincre qu'ils ne sont pas blessés. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je reviendrai vous remercier. »",
              "next": "s1_05"
            }
          ]
        },
        "s1_05": {
          "texte": "« Tu peux commencer par revenir vivant. Ce sera déjà un bon début. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je tâcherai de m'en souvenir. »",
              "next": "s1_06"
            }
          ]
        },
        "s1_06": {
          "texte": "« Fais donc ça. Et évite de saigner davantage sur mon plancher. »",
          "choix": [
            {
              "id": "soin",
              "label": "(La laisser faire.)",
              "action": {
                "service": "soin"
              }
            }
          ]
        },
        "s2_01": {
          "texte": "Elle n'a pas besoin de lever la tête. « Tiens donc. Encore toi. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Vous semblez déçue. »",
              "next": "s2_02"
            }
          ]
        },
        "s2_02": {
          "texte": "« Pas du tout. Je commençais justement à me demander combien de temps tu allais réussir à rester entier. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je fais des progrès. »",
              "next": "s2_03"
            }
          ]
        },
        "s2_03": {
          "texte": "« Je vois ça. Cette fois, tu n'as qu'une seule blessure. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Vous avez remarqué ? »",
              "next": "s2_04"
            }
          ]
        },
        "s2_04": {
          "texte": "« Je suis guérisseuse. Et tu as toujours la même façon de poser ton sac quand tu es fatigué. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Vous commencez à bien me connaître. »",
              "next": "s2_05"
            }
          ]
        },
        "s2_05": {
          "texte": "« Tu viens assez souvent pour ça. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Peut-être que j'aime cette auberge. »",
              "next": "s2_06"
            }
          ]
        },
        "s2_06": {
          "texte": "« Peut-être. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Ou peut-être que j'aime bien y trouver quelqu'un qui se souvient de mon nom. »",
              "next": "s2_07"
            }
          ]
        },
        "s2_07": {
          "texte": "« Alors tâche de ne pas me donner trop de raisons de m'en souvenir. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je vais essayer. »",
              "next": "s2_08"
            }
          ]
        },
        "s2_08": {
          "texte": "Elle pointe sur toi une pince à échardes. « Non. Tu vas vraiment essayer. »",
          "choix": [
            {
              "id": "soin",
              "label": "(Lui tendre ton bras.)",
              "action": {
                "service": "soin"
              }
            },
            {
              "id": "fin",
              "label": "(Hocher la tête.)",
              "next": "fin"
            }
          ]
        },
        "s3_01": {
          "texte": "Elle repose le mortier. « J'ai besoin d'une petite faveur. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Ça commence toujours comme ça. »",
              "next": "s3_02"
            }
          ]
        },
        "s3_02": {
          "texte": "« Je cherche une plante qui pousse sur les collines, au nord-est de la ville. Une fleur orange, comme un petit soleil : du souci. Tu en as peut-être vu. »",
          "choix": [
            {
              "id": "suite",
              "label": "« À quoi ça sert ? »",
              "next": "s3_03"
            }
          ]
        },
        "s3_03": {
          "texte": "« À faire baisser la fièvre. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Vous n'en avez plus ? »",
              "next": "s3_04"
            }
          ]
        },
        "s3_04": {
          "texte": "« Presque plus. Et avec le nombre de voyageurs blessés qui passent ici, je préfère ne pas attendre la dernière fleur. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je regarderai. »",
              "next": "s3_05"
            }
          ]
        },
        "s3_05": {
          "texte": "« Tu n'es pas obligé. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je sais. »",
              "next": "s3_06"
            }
          ]
        },
        "s3_06": {
          "texte": "« Alors pourquoi accepter ? »",
          "choix": [
            {
              "id": "suite",
              "label": "« Parce que vous m'avez déjà soigné gratuitement. »",
              "next": "s3_07"
            }
          ]
        },
        "s3_07": {
          "texte": "« Une fois. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Deux fois. »",
              "next": "s3_08"
            }
          ]
        },
        "s3_08": {
          "texte": "« Trois. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Alors je vous dois trois plantes. »",
              "next": "s3_09"
            }
          ]
        },
        "s3_09": {
          "texte": "« Voilà qui est raisonnable. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Comment je saurai si c'est la bonne ? »",
              "next": "s3_10"
            }
          ]
        },
        "s3_10": {
          "texte": "« Tu ne la cueilles pas si tu n'es pas sûr. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Pourquoi ? »",
              "next": "s3_11"
            }
          ]
        },
        "s3_11": {
          "texte": "« Parce qu'une mauvaise herbe peut soigner beaucoup moins bien qu'une bonne. »",
          "choix": [
            {
              "id": "suite",
              "label": "« C'est tout ? »",
              "next": "s3_12"
            }
          ]
        },
        "s3_12": {
          "texte": "« C'est surtout une manière élégante de te dire de ne pas mourir en voulant m'aider. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je ferai attention. »",
              "next": "s3_13"
            }
          ]
        },
        "s3_13": {
          "texte": "« Je compte sur toi. »",
          "choix": [
            {
              "id": "accepter",
              "label": "« Montrez-moi à quoi elle ressemble. »",
              "condition": {
                "apport_offert": true
              },
              "action": {
                "service": "apport",
                "op": "accepter"
              }
            },
            {
              "id": "fin",
              "label": "(Lui laisser reprendre son mortier.)",
              "next": "fin"
            }
          ]
        },
        "s4_01": {
          "texte": "Elle noue le cordon d'un panier vide et relève la tête. « Tu tombes bien. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Pourquoi ? »",
              "next": "s4_02"
            }
          ]
        },
        "s4_02": {
          "texte": "« Je pars dans la forêt. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Maintenant ? »",
              "next": "s4_03"
            }
          ]
        },
        "s4_03": {
          "texte": "« Oui. J'ai presque épuisé mes réserves de plantes médicinales. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Je peux venir avec vous. »",
              "next": "s4_04"
            }
          ]
        },
        "s4_04": {
          "texte": "« Pour ramasser des feuilles ? »",
          "choix": [
            {
              "id": "suite",
              "label": "« Si vous voulez. »",
              "next": "s4_05"
            }
          ]
        },
        "s4_05": {
          "texte": "« Tu as mieux à faire. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Probablement. »",
              "next": "s4_06"
            }
          ]
        },
        "s4_06": {
          "texte": "« Alors fais-le. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Vous savez, je pourrais vraiment vous accompagner. »",
              "next": "s4_07"
            }
          ]
        },
        "s4_07": {
          "texte": "« Je connais cette forêt depuis des années. Je serai de retour avant le déjeuner. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Promis ? »",
              "next": "s4_08"
            }
          ]
        },
        "s4_08": {
          "texte": "« Promis. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Alors à tout à l'heure. »",
              "next": "s4_09"
            }
          ]
        },
        "s4_09": {
          "texte": "« À tout à l'heure. »",
          "choix": [
            {
              "id": "suite",
              "label": "« Élise ? »",
              "next": "s4_10"
            }
          ]
        },
        "s4_10": {
          "texte": "Elle se retourne sur le seuil. « Oui ? »",
          "choix": [
            {
              "id": "suite",
              "label": "« Faites attention. »",
              "next": "s4_11"
            }
          ]
        },
        "s4_11": {
          "texte": "« Toujours. »",
          "choix": [
