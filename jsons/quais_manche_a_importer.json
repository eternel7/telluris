          "embarque": "a_bord",
          "sans_fonds": "pauvre"
        }
      }
    },
    "dialogue": {
      "noeud_depart": "accueil",
      "noeuds": {
        "accueil": {
          "texte": "{pnj} lève les yeux d'un rouleau de cordage. « Pour Douvres ? Le Pas est court, mais il a des dents. On part avec la marée, on arrive avant la nuit, la plupart du temps. Places à bord : {passagers}. Ce sera {tarif}. »",
          "choix": [
            {
              "id": "embarquer",
              "label": "Payer {tarif} et monter à bord.",
              "action": {
                "service": "traversee",
                "op": "embarquer"
              }
            },
            {
              "id": "danger",
              "label": "Qu'est-ce qui rôde au large ?",
              "next": "danger"
            },
            {
              "id": "fin",
              "label": "Une autre fois.",
              "next": "fin"
            }
          ]
        },
        "danger": {
          "texte": "« Des sirènes près des côtes, qui chantent pour qu'on approche des récifs. Au large, des tritons, et parfois un bras de kraken qui sort de l'eau sans prévenir. » {pnj} montre du menton les deux tours dont les runes rougeoient au-dessus du bassin. « Tant qu'on les voit briller, rien n'entre au port. Après, c'est l'équipage… et vous. »",
          "choix": [
            {
              "id": "retour",
              "label": "Revenir au passage.",
              "next": "accueil"
            },
            {
              "id": "fin",
              "label": "Une autre fois.",
              "next": "fin"
            }
          ]
        },
        "a_bord": {
          "texte": "« Larguez les amarres ! » Le navire s'écarte du quai et prend le vent. Cap sur Douvres.",
          "choix": [
            {
              "id": "fin",
              "label": "Monter à bord.",
              "next": "fin"
            }
          ]
        },
        "pauvre": {
          "texte": "{pnj} compte vos pièces et secoue la tête. « Ça ne paie pas la place. Revenez avec {tarif}, et on lève l'ancre. »",
          "choix": [
            {
              "id": "fin",
              "label": "Repartir.",
              "next": "fin"
            }
          ]
        }
      }
    }
  },
