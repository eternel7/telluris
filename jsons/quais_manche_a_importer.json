  {
    "_id": "pnj:capitaine_douvres",
    "type": "pnj",
    "nom": "Godwin Hale",
    "race": "ogre",
    "portrait": "capitaine_ogre_m_douvres01.jpg",
    "vocation": "guerrier",
    "description": "Patron d'un navire qui fait la traversée du Pas vers Calais.",
    "services": {
      "traversee": {
        "route": "traversee:douvres_calais",
        "noeuds": {
          "embarque": "a_bord",
          "sans_fonds": "pauvre"
        }
      }
    },
    "dialogue": {
      "noeud_depart": "accueil",
      "noeuds": {
        "accueil": {
          "texte": "{pnj} se déplie de toute sa hauteur sur le quai. « Calais ? Bonne idée, la mer est calme. Pour l'instant. Places à bord : {passagers}. Le passage coûte {tarif}. »",
          "choix": [
            {
              "id": "embarquer",
              "label": "Payer {tarif} et monter à bord.",
              "action": {
                "service": "traversee",
                "op": "embarquer"
              }
            },
            {
              "id": "danger",
              "label": "Qu'est-ce qui rôde au large ?",
              "next": "danger"
            },
            {
              "id": "fin",
              "label": "Une autre fois.",
              "next": "fin"
            }
          ]
        },
        "danger": {
          "texte": "« Le vieux phare des falaises nous garde l'entrée du port, depuis plus longtemps que n'importe qui ne s'en souvient. Plus loin, il ne garde plus rien. » {pnj} hausse ses énormes épaules. « Les serpents suivent les coques, les sirènes guettent les imprudents. On repousse ce qui monte à bord. Le reste, on le contourne. »",
          "choix": [
            {
              "id": "retour",
              "label": "Revenir au passage.",
              "next": "accueil"
            },
            {
              "id": "fin",
              "label": "Une autre fois.",
              "next": "fin"
            }
          ]
        },
        "a_bord": {
          "texte": "« Larguez les amarres ! » Le navire s'écarte du quai et prend le vent. Cap sur Calais.",
          "choix": [
            {
              "id": "fin",
              "label": "Monter à bord.",
              "next": "fin"
            }
          ]
        },
        "pauvre": {
          "texte": "{pnj} compte vos pièces et secoue la tête. « Ça ne paie pas la place. Revenez avec {tarif}, et on lève l'ancre. »",
          "choix": [
            {
              "id": "fin",
              "label": "Repartir.",
              "next": "fin"
            }
          ]
        }
      }
    }
  },
