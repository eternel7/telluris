  {
    "_id": "pnj:capitaine_calais_nord",
    "type": "pnj",
    "nom": "Aubin Cordemâle",
    "race": "nain",
    "portrait": "capitaine_nain_m_calais01.jpg",
    "vocation": "guerrier",
    "description": "Patron d'un navire trapu qui fait la traversée du Pas vers Douvres depuis le bassin nord.",
    "services": {
      "traversee": {
        "route": "traversee:calais_nord_douvres",
        "noeuds": {
          "embarque": "a_bord",
          "sans_fonds": "pauvre"
        }
      }
    },
    "dialogue": {
      "noeud_depart": "accueil",
      "noeuds": {
        "accueil": {
          "texte": "{pnj} tape du plat de la main sur la coque de son navire, large et bas sur l'eau. « Il ne gagne pas de courses, mais il arrive. Douvres, c'est ça ? Places à bord : {passagers}. Ce sera {tarif}. »",
          "choix": [
            {
              "id": "embarquer",
              "label": "Payer {tarif} et monter à bord.",
              "action": {
                "service": "traversee",
                "op": "embarquer"
              }
            },
            {
              "id": "danger",
              "label": "Qu'est-ce qui rôde au large ?",
              "next": "danger"
            },
            {
              "id": "fin",
              "label": "Une autre fois.",
              "next": "fin"
            }
          ]
        },
        "danger": {
          "texte": "« Des tritons qui tirent sur les filins, des sirènes qui chantent aux matelots trop jeunes. » {pnj} montre la hache passée au mât. « Et quand un bras de kraken monte sur le pont, on coupe. On ne discute pas avec un kraken. »",
          "choix": [
            {
              "id": "retour",
              "label": "Revenir au passage.",
              "next": "accueil"
            },
            {
              "id": "fin",
              "label": "Une autre fois.",
              "next": "fin"
            }
          ]
        },
        "a_bord": {
          "texte": "« Larguez ! » Le navire du bassin nord quitte le quai à la rame puis prend le vent. Cap sur Douvres.",
          "choix": [
            {
              "id": "fin",
              "label": "Monter à bord.",
              "next": "fin"
            }
          ]
        },
        "pauvre": {
          "texte": "{pnj} compte vos pièces et secoue la tête. « Ça ne paie pas la place. Revenez avec {tarif}, et on lève l'ancre. »",
          "choix": [
            {
              "id": "fin",
              "label": "Repartir.",
              "next": "fin"
            }
          ]
        }
      }
    }
  },
