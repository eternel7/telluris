{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },

  "model": "sonnet",

  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true
  },

  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "file=$(jq -r '.tool_input.file_path'); case \"$file\" in *.py) ruff check --fix \"$file\" ;; esac"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "file=$(jq -r '.tool_input.file_path'); git diff --stat -- \"$file\""
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -m pytest -q"
          }
        ]
      }
    ]
  }
}