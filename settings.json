{
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "model": "opus",
  "skillOverrides": {
    "chrome-devtools-mcp:a11y-debugging": "off",
    "chrome-devtools-mcp:chrome-devtools": "off",
    "chrome-devtools-mcp:chrome-devtools-cli": "off",
    "chrome-devtools-mcp:debug-optimize-lcp": "off",
    "chrome-devtools-mcp:memory-leak-debugging": "off",
    "chrome-devtools-mcp:troubleshooting": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path'); case \"$file\" in *.py) ruff check --fix \"$file\" ;; esac",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "file=$(jq -r '.tool_input.file_path'); git diff --stat -- \"$file\"",
            "shell": "bash"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m pytest -q",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true
  },
  "autoUpdatesChannel": "latest",
  "autoMemoryEnabled": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}